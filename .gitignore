# Secrets — never tracked (ANTHROPIC_API_KEY lives here)
.env

# Virtualenv
.venv/

# Regenerable extraction/HTTP cache.
# Tests do not read this: they use tests/fixtures/recorded_http_bin and
# per-test tmp cache dirs, so untracking it is safe for a fresh clone.
.cache/

# Tool caches
.pytest_cache/
.ruff_cache/

# Python bytecode
__pycache__/
*.pyc

# Agent/implementer scratch space. Issue files live in .scratch/<feature>/ and
# ARE tracked; this is the throwaway sibling for pytest dumps, junit xml and
# throwaway prototypes, so an automated `git add -A` cannot sweep them into a
# commit.
.scratch/tmp/
